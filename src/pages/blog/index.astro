---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import heroArt from "../../assets/art/hero-blog.png";

const heroArtSrc = typeof heroArt === "string" ? heroArt : heroArt.src;

const allPosts = (await getCollection("blog")).filter((post) => !post.data.draft);

const pinnedPosts = allPosts
  .filter((post) => post.data.pinned)
  .sort((a, b) => a.data.pinnedOrder - b.data.pinnedOrder);

const posts = allPosts
  .filter((post) => !post.data.pinned)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormat = new Intl.DateTimeFormat("en-IN", { dateStyle: "medium" });
---

<BaseLayout
  title="Blog | Rust India"
  description="News, write-ups, and community notes from Rust India."
>
  <SiteHeader currentPath="/blog/" />

  <main class="site-main">
    <section class="section-shell">
      <header class="page-header page-header--split">
        <div>
          <p class="section-label">Blog</p>
          <h1 class="page-title">Blog</h1>
          <p class="page-lede">News, write-ups, and community notes from Rust India.</p>
        </div>
        <img class="page-header__art" src={heroArtSrc} alt="" aria-hidden="true" />
      </header>

      {
        pinnedPosts.length > 0 && (
          <section class="pinned-section" aria-label="Pinned posts">
            <h2 class="pinned-section__title">Pinned</h2>
            <div class="pinned-list">
              {
                pinnedPosts.map((post) => (
                  <a href={`/blog/${post.id}/`} class="pinned-capsule" data-post-card>
                    <span class="pinned-capsule__mark" aria-hidden="true"></span>
                    <span class="pinned-capsule__title">{post.data.title}</span>
                    <span class="pinned-capsule__date">{dateFormat.format(post.data.pubDate)}</span>
                  </a>
                ))
              }
            </div>
          </section>
        )
      }

      <input
        type="search"
        class="blog-search"
        data-blog-search
        placeholder="Search posts..."
        aria-label="Search posts"
      />

      {
        posts.length > 0 && (
          <div class="card-grid" data-blog-grid>
            {
              posts.map((post) => (
                <a href={`/blog/${post.id}/`} class="card post-card" data-post-card>
                  <h2 class="post-card__title">{post.data.title}</h2>
                  <p class="post-card__meta">
                    {dateFormat.format(post.data.pubDate)} · {post.data.author}
                  </p>
                  <p class="post-card__desc">{post.data.description}</p>
                  <p class="post-card__tags">
                    {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </p>
                </a>
              ))
            }
          </div>
        )
      }

      {
        posts.length === 0 && (
          <p class="card empty-state">
            {pinnedPosts.length > 0 ? "No more posts." : "No posts yet."}
          </p>
        )
      }

      <p class="card empty-state blog-search-empty" data-blog-empty hidden>
        No posts match your search.
      </p>

      <p class="blog-rss">
        Subscribe via <a href="/rss.xml">RSS</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  const searchInput = document.querySelector("[data-blog-search]");
  const postCards = Array.from(document.querySelectorAll("[data-post-card]"));
  const emptyNote = document.querySelector("[data-blog-empty]");

  if (searchInput && postCards.length && emptyNote) {
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;

      postCards.forEach((card) => {
        const matches = !query || card.textContent.toLowerCase().includes(query);
        card.classList.toggle("is-hidden", !matches);
        if (matches) {
          visible += 1;
        }
      });

      emptyNote.hidden = visible !== 0;
    });
  }
</script>

<style>
  .blog-search {
    width: min(24rem, 100%);
    margin: 0 0 1.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-input);
    font: inherit;
    color: var(--color-ink);
  }

  .blog-search:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .post-card.is-hidden {
    display: none;
  }

  .blog-search-empty {
    display: block;
  }

  .pinned-section {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .pinned-section__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .pinned-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .pinned-capsule {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.9rem;
    background: var(--color-input);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-ink);
    font-size: 0.9rem;
  }

  .pinned-capsule:hover {
    border-color: var(--color-accent);
  }

  .pinned-capsule:hover .pinned-capsule__title {
    color: var(--color-accent);
  }

  .pinned-capsule__mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }

  .pinned-capsule__title {
    font-weight: 600;
  }

  .pinned-capsule__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }

  .blog-rss {
    margin-top: 2rem;
    color: var(--color-ink-soft);
  }
</style>
