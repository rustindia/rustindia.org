---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Job {
  badge: string;
  badgeBg: string;
  badgeFg: string;
  title: string;
  company: string;
  posted: string;
  workMode: string;
  workModeLabel: string;
  level: string;
  levelLabel: string;
  tags: string[];
  summary: string;
  actionHref: string;
  actionLabel: string;
}

const filterGroups = [
  {
    id: "workMode",
    title: "Work Mode",
    options: [
      { value: "remote", label: "Remote" },
      { value: "hybrid", label: "Hybrid" },
      { value: "onsite", label: "On-site (India)" },
    ],
  },
  {
    id: "level",
    title: "Experience Level",
    options: [
      { value: "senior", label: "Senior" },
      { value: "mid", label: "Mid-Level" },
      { value: "junior", label: "Junior" },
    ],
  },
];

const jobs: Job[] = [];

const inviteCard = {
  badge: "+",
  title: "Want to add a role here?",
  company: "Rust India Jobs Board",
  posted: "Submissions open",
  summary: "Mail the team with the role, company, work mode, and level. We will publish relevant Rust openings on the board.",
  tags: ["Submit a job", "Rust hiring", "Hiring"],
  actionHref: "mailto:jobs@rustindia.org?subject=Rust%20India%20Job%20Submission",
  actionLabel: "Submit a Job",
};
---

<BaseLayout
  title="Jobs | Rust India"
  description="Rust roles from teams hiring across India, on the Rust India community jobs board."
>
  <SiteHeader currentPath="/jobs/" />

  <main class="site-main">
    <section class="jobs-header section-shell">
      <p class="section-label">Jobs Board</p>
      <h1 class="jobs-header__title">Posted Jobs</h1>
      <p class="jobs-header__lede">Rust-focused roles from teams hiring across India. Use the filters to narrow by work mode and experience level.</p>
    </section>

    <section class="jobs-board section-shell">
      <aside class="jobs-filter frame-panel">
        <h2 class="jobs-filter__title">Filters</h2>
        <p class="jobs-filter__intro">Filter the board by work mode and experience level. Counts update live as jobs are added.</p>

        <form class="jobs-filter__form" data-jobs-filters>
          {
            filterGroups.map((group) => (
              <div class="filter-group">
                <div class="filter-group__head">
                  <h3>{group.title}</h3>
                  <span class="filter-group__meta" data-filter-selected={group.id}></span>
                </div>

                <div class="filter-options">
                  {
                    group.options.map((option) => (
                      <div class="filter-option">
                        <label class="filter-option__label">
                          <input checked type="checkbox" value={option.value} data-filter-group={group.id} />
                          <span class="filter-option__knob" aria-hidden="true"></span>
                          <span class="filter-option__text">{option.label}</span>
                        </label>
                        <span class="filter-count" data-filter-count={`${group.id}:${option.value}`}></span>
                      </div>
                    ))
                  }
                </div>
              </div>
            ))
          }
        </form>

        <div class="jobs-filter__actions">
          <button type="button" class="btn btn-primary" data-filter-reset>Reset Filters</button>
          <a href={inviteCard.actionHref} class="btn btn-primary">{inviteCard.actionLabel}</a>
        </div>
      </aside>

      <div class="jobs-board__main">
        <div class="jobs-results frame-panel" role="status" aria-live="polite">
          <p class="section-label">Open Roles</p>
          <h2 class="jobs-results__title"><span data-jobs-count>{jobs.length}</span> open roles</h2>
          <p class="jobs-results__note" data-jobs-state>No postings yet — submit a job to be the first on the board.</p>
        </div>

        <div class="jobs-list">
          {
            jobs.map((job) => (
              <article
                class="job-row frame-panel"
                style={`--badge-bg:${job.badgeBg}; --badge-fg:${job.badgeFg};`}
                data-job-card
                data-work-mode={job.workMode}
                data-level={job.level}
              >
                <div class="job-row__lead">
                  <div class="job-row__badge">{job.badge}</div>

                  <div class="job-row__content">
                    <div class="job-row__headline">
                      <h2 class="job-row__title">{job.title}</h2>
                    </div>

                    <div class="job-row__meta">
                      <span class="job-row__company">{job.company}</span>
                      <span class="job-row__posted">{job.posted}</span>
                      <span class="job-row__meta-pill">{job.workModeLabel}</span>
                      <span class="job-row__meta-pill">{job.levelLabel}</span>
                    </div>

                    <div class="job-row__tags">
                      {job.tags.map((tag) => <span class="tag">{tag}</span>)}
                    </div>

                    <p class="job-row__summary">{job.summary}</p>
                  </div>

                  <a href={job.actionHref} class="btn btn-secondary job-row__action">
                    {job.actionLabel}
                  </a>
                </div>
              </article>
            ))
          }

          <article class="job-row job-row--empty frame-panel" data-jobs-empty hidden>
            <p class="section-label">No Jobs Yet</p>
            <h2 class="job-row__title">There are no live job posts on the board right now.</h2>
            <p class="job-row__summary">You can still adjust the filters, and hiring teams can use the submit flow below to add the first opening.</p>
          </article>

          <article class="job-row job-row--invite accent-panel">
            <div class="job-row__lead">
              <div class="job-row__badge job-row__badge--light">{inviteCard.badge}</div>

              <div class="job-row__content">
                <div class="job-row__headline">
                  <h2 class="job-row__title">{inviteCard.title}</h2>
                </div>

                <div class="job-row__meta">
                  <span class="job-row__company">{inviteCard.company}</span>
                  <span class="job-row__posted">{inviteCard.posted}</span>
                </div>

                <div class="job-row__tags">
                  {inviteCard.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>

                <p class="job-row__summary">{inviteCard.summary}</p>
              </div>

              <a href={inviteCard.actionHref} class="btn btn-primary job-row__action">
                {inviteCard.actionLabel}
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  const filterForm = document.querySelector("[data-jobs-filters]");
  const jobCards = Array.from(document.querySelectorAll("[data-job-card]"));
  const resultsCount = document.querySelector("[data-jobs-count]");
  const resultsState = document.querySelector("[data-jobs-state]");
  const emptyState = document.querySelector("[data-jobs-empty]");
  const resetButton = document.querySelector("[data-filter-reset]");
  const selectedMeta = new Map(
    Array.from(document.querySelectorAll("[data-filter-selected]")).map((node) => [node.dataset.filterSelected, node]),
  );
  const countNodes = new Map(
    Array.from(document.querySelectorAll("[data-filter-count]")).map((node) => [node.dataset.filterCount, node]),
  );

  if (filterForm && resultsCount && resultsState && emptyState && resetButton) {
    const inputs = Array.from(filterForm.querySelectorAll("input[data-filter-group]"));
    const groups = [...new Set(inputs.map((input) => input.dataset.filterGroup).filter(Boolean))];

    const selectionsFor = (excludeGroup) =>
      groups.reduce((acc, group) => {
        if (group === excludeGroup) {
          return acc;
        }

        acc[group] = inputs
          .filter((input) => input.dataset.filterGroup === group && input.checked)
          .map((input) => input.value);
        return acc;
      }, {});

    const matchesSelections = (card, selections) =>
      groups.every((group) => {
        const allowed = selections[group] ?? [];
        if (!allowed.length) {
          return false;
        }

        return allowed.includes(card.dataset[group]);
      });

    const updateGroupMeta = () => {
      groups.forEach((group) => {
        const groupInputs = inputs.filter((input) => input.dataset.filterGroup === group);
        const checked = groupInputs.filter((input) => input.checked);
        const meta = selectedMeta.get(group);

        if (meta) {
          meta.textContent = `${checked.length}/${groupInputs.length} on`;
        }
      });
    };

    const updateOptionCounts = () => {
      groups.forEach((group) => {
        const groupInputs = inputs.filter((input) => input.dataset.filterGroup === group);
        const otherSelections = selectionsFor(group);

        groupInputs.forEach((input) => {
          const count = jobCards.filter((card) => {
            const matchesOtherGroups = groups.every((otherGroup) => {
              if (otherGroup === group) {
                return true;
              }

              const allowed = otherSelections[otherGroup] ?? [];
              if (!allowed.length) {
                return false;
              }

              return allowed.includes(card.dataset[otherGroup]);
            });

            return matchesOtherGroups && card.dataset[group] === input.value;
          }).length;

          const countKey = `${group}:${input.value}`;
          const countNode = countNodes.get(countKey);
          if (countNode) {
            countNode.textContent = String(count);
            countNode.dataset.empty = count === 0 ? "true" : "false";
          }

          input.closest(".filter-option")?.toggleAttribute("data-empty", count === 0);
        });
      });
    };

    const updateJobsBoard = () => {
      const activeSelections = selectionsFor();
      let visibleCount = 0;

      jobCards.forEach((card) => {
        const visible = matchesSelections(card, activeSelections);
        card.hidden = !visible;
        if (visible) {
          visibleCount += 1;
        }
      });

      emptyState.hidden = visibleCount !== 0;
      resultsCount.textContent = String(visibleCount);
      resultsState.textContent =
        visibleCount === 0
          ? "No jobs match the current filters yet. Reset the filters or submit a job."
          : `${visibleCount} ${visibleCount === 1 ? "role matches" : "roles match"} your current filters.`;

      updateGroupMeta();
      updateOptionCounts();
    };

    filterForm.addEventListener("change", updateJobsBoard);
    resetButton.addEventListener("click", () => {
      inputs.forEach((input) => {
        input.checked = true;
      });
      updateJobsBoard();
    });

    updateJobsBoard();
  }
</script>

<style>
  /* Old conference UI, ported with literal colors */
  .section-label {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #db604a;
  }

  .frame-panel,
  .accent-panel {
    position: relative;
    border: 3px solid #4b2217;
    border-radius: 2rem;
    box-shadow: 10px 10px 0 #ea7d63;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .frame-panel:hover,
  .accent-panel:hover {
    transform: translate(-2px, -2px);
    box-shadow: 12px 12px 0 #ea7d63;
  }

  .frame-panel {
    background: #fff8ef;
  }

  .accent-panel {
    background: #ef745d;
    color: #fff9f2;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.95rem 1.55rem;
    border: 3px solid #4b2217;
    border-radius: 1.2rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 6px 6px 0 rgb(75 34 23 / 0.28);
  }

  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 rgb(75 34 23 / 0.24);
  }

  .btn-primary {
    background: #ef745d;
    color: #fffaf1;
  }

  .btn-secondary {
    background: #fff8ef;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.8rem;
    border: 2px solid #4b2217;
    border-radius: 999px;
    background: #fff7e8;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1;
  }

  .jobs-header {
    padding-top: 3rem;
  }

  .jobs-header__title {
    margin: 0;
    font-family: "Baloo 2", "Segoe UI", sans-serif;
    font-size: clamp(3.4rem, 8vw, 6rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .jobs-header__lede {
    width: min(46rem, 100%);
    margin-top: 1.5rem;
    padding-left: 1.1rem;
    border-left: 4px solid #ef745d;
    font-size: clamp(1.18rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    color: #7f584a;
  }

  .jobs-board {
    display: grid;
    gap: 2rem;
    padding-top: 2.7rem;
  }

  .jobs-board__main {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .jobs-filter {
    align-self: start;
    padding: 1.6rem;
  }

  .jobs-filter__title {
    margin: 0;
    font-family: "Baloo 2", "Segoe UI", sans-serif;
    font-size: 2.4rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .jobs-filter__intro {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 3px solid #4b2217;
    color: #7f584a;
  }

  .jobs-filter__form {
    display: grid;
    gap: 1.4rem;
    margin-top: 1.8rem;
  }

  .filter-group+.filter-group {
    padding-top: 1.4rem;
    border-top: 2px solid rgb(75 34 23 / 0.12);
  }

  .filter-group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .filter-group h3 {
    margin: 0;
    font-family: "Baloo 2", "Segoe UI", sans-serif;
    font-size: 1.55rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .filter-group__meta {
    color: #7f584a;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .filter-options {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .filter-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.95rem;
    border: 2px solid rgb(75 34 23 / 0.12);
    border-radius: 1rem;
    background: #fffaf3;
  }

  .filter-option[data-empty="true"] {
    opacity: 0.58;
  }

  .filter-option__label {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1 1 auto;
    cursor: pointer;
  }

  .filter-option input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .filter-option__knob {
    position: relative;
    width: 2.4rem;
    height: 1.5rem;
    flex: 0 0 auto;
    border: 3px solid #4b2217;
    border-radius: 999px;
    background: #fffdf7;
    transition: background-color 0.18s ease;
  }

  .filter-option__knob::after {
    content: "";
    position: absolute;
    top: 0.15rem;
    left: 0.16rem;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: #4b2217;
    transition: transform 0.18s ease, background-color 0.18s ease;
  }

  .filter-option__label input:checked+.filter-option__knob {
    background: #f3d1c6;
  }

  .filter-option__label input:checked+.filter-option__knob::after {
    transform: translateX(0.78rem);
    background: #db604a;
  }

  .filter-option__label input:focus-visible+.filter-option__knob {
    outline: 3px solid rgb(239 116 93 / 0.85);
    outline-offset: 3px;
  }

  .filter-option__text {
    min-width: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .filter-count {
    min-width: 2.4rem;
    padding: 0.2rem 0.55rem;
    border: 2px solid #4b2217;
    border-radius: 999px;
    background: #fff7e8;
    text-align: center;
    font-weight: 700;
  }

  .filter-count[data-empty="true"] {
    opacity: 0.58;
  }

  .jobs-filter__actions {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .jobs-results {
    padding: 1.35rem 1.55rem;
  }

  .jobs-results__title {
    margin: 0.35rem 0 0;
    font-family: "Baloo 2", "Segoe UI", sans-serif;
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .jobs-results__note {
    margin: 0.65rem 0 0;
    color: #7f584a;
    font-size: 1rem;
  }

  .jobs-list {
    display: grid;
    gap: 1.5rem;
  }

  .job-row {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.5rem 1.65rem;
  }

  .job-row__lead {
    display: grid;
    gap: 1rem;
  }

  .job-row__content {
    min-width: 0;
  }

  .job-row__badge {
    display: grid;
    place-items: center;
    width: 4.7rem;
    height: 4.7rem;
    border: 3px solid #4b2217;
    border-radius: 1.1rem;
    background: var(--badge-bg, #ffc069);
    color: var(--badge-fg, #4b2217);
    font-family: "Baloo 2", "Segoe UI", sans-serif;
    font-size: 2rem;
    line-height: 1;
  }

  .job-row__badge--light {
    border-color: rgb(255 249 242 / 0.96);
    background: rgb(255 249 242 / 0.16);
    color: #fff9f2;
  }

  .job-row__headline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    align-items: baseline;
  }

  .job-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.75rem;
    align-items: center;
    margin-top: 0.8rem;
  }

  .job-row__title {
    margin: 0;
    font-family: "Baloo 2", "Segoe UI", sans-serif;
    font-size: clamp(2rem, 3vw, 2.7rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .job-row__company,
  .job-row__posted {
    color: #db604a;
    font-size: 1.02rem;
    font-weight: 700;
  }

  .job-row__meta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.7rem;
    border: 2px solid rgb(75 34 23 / 0.16);
    border-radius: 999px;
    background: rgb(239 116 93 / 0.09);
    color: #db604a;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
  }

  .job-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .job-row__summary {
    max-width: 48rem;
    margin: 0.9rem 0 0;
    color: #7f584a;
    font-size: 1.05rem;
  }

  .job-row__action {
    align-self: center;
  }

  .job-row--empty {
    text-align: center;
  }

  .job-row--empty .job-row__title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .job-row--empty .job-row__summary {
    margin-right: auto;
    margin-left: auto;
  }

  .job-row--invite .job-row__company,
  .job-row--invite .job-row__posted,
  .job-row--invite .job-row__summary {
    color: rgb(255 248 240 / 0.92);
  }

  .job-row--invite .tag {
    border-color: rgb(255 248 240 / 0.45);
    background: rgb(255 248 240 / 0.12);
    color: #fff9f2;
  }

  @media (min-width: 760px) {
    .jobs-board {
      grid-template-columns: minmax(18rem, 21rem) minmax(0, 1fr);
      align-items: start;
    }

    .job-row__lead {
      grid-template-columns: 4.7rem minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  @media (max-width: 759px) {
    .jobs-header {
      padding-top: 2.4rem;
    }

    .jobs-filter,
    .jobs-results,
    .job-row {
      padding-left: 1.4rem;
      padding-right: 1.4rem;
    }

    .btn {
      width: 100%;
    }

    .jobs-filter__actions {
      align-items: stretch;
    }

    .job-row__action {
      justify-self: start;
    }
  }
</style>
</BaseLayout>
