---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import MailingList from "../components/MailingList.astro";
import { getCollection } from "astro:content";
import heroArt from "../assets/art/hero-home.png";

const heroArtSrc = typeof heroArt === "string" ? heroArt : heroArt.src;

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const now = new Date();
const upcomingEvents = (await getCollection("events"))
  .filter((event) => event.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const dateFormat = new Intl.DateTimeFormat("en-IN", { dateStyle: "medium" });

function excerpt(body: string): string {
  return body
    .trim()
    .split(/\n\n+/)[0]
    .replace(/\n/g, " ")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .trim();
}

const communityLinks = [
  { name: "Discord", link: "https://discord.com/invite/p3uaTXS6NP" },
  { name: "X", link: "https://x.com/IndiaRust" },
  { name: "Bluesky", link: "https://bsky.app/profile/rustindia.bsky.social" },
  { name: "Matrix", link: "https://matrix.to/#/#rustindia:matrix.org" },
  { name: "LinkedIn", link: "https://www.linkedin.com/company/rust-india" },
  { name: "Telegram", link: "https://t.me/RustIndia" },
];
---

<BaseLayout
  title="Rust India"
  description="The home of the Rust programming language community in India — blog, events, and ways to connect."
>
  <SiteHeader currentPath="/" />

  <main class="site-main">
    <section class="section-shell hero">
      <div class="hero__copy">
        <p class="section-label">The Indian Rust community</p>
        <h1 class="page-title hero__title">Rust India</h1>
        <p class="hero__lede">
          The home of the Rust programming language community in India — blog, events, and ways to connect.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary" href="/community/">Join the Community</a>
          <a class="btn btn-secondary" href="/blog/">Read the Blog</a>
        </div>
      </div>
      <img class="hero__art" src={heroArtSrc} alt="" aria-hidden="true" />
    </section>

    <section class="section-shell home-section">
      <h2 class="section-title">Follow us on RSS</h2>
      <p class="home-section__lede">
        New posts land in your feed reader the moment they are published.
      </p>
      <p class="feed-block__action">
        <a class="btn btn-primary" href="/rss.xml">Subscribe</a>
      </p>
    </section>

    <section class="section-shell home-section">
      <div class="home-section__head">
        <h2 class="section-title">Latest posts</h2>
        <a class="home-section__link" href="/blog/">View all</a>
      </div>
      <div class="card-grid">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="card post-card">
              <p class="post-card__meta">
                {dateFormat.format(post.data.pubDate)} · {post.data.author}
              </p>
              <h3 class="post-card__title">{post.data.title}</h3>
              <p class="post-card__desc">{post.data.description}</p>
              <p class="post-card__tags">
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section-shell home-section">
      <div class="home-section__head">
        <h2 class="section-title">Upcoming events</h2>
        <a class="home-section__link" href="/events/">All events</a>
      </div>
      {
        upcomingEvents.length > 0 ? (
          <div class="card-grid">
            {
              upcomingEvents.map((event) => (
                <div class="card event-card">
                  <p class="event-card__meta">
                    {dateFormat.format(event.data.date)} · {event.data.location}
                  </p>
                  <h3 class="event-card__title">{event.data.title}</h3>
                  <p class="event-card__desc">{excerpt(event.body)}</p>
                  {
                    event.data.url && (
                      <p class="event-card__action">
                        <a
                          class="btn btn-secondary"
                          href={event.data.url}
                          target={event.data.url.startsWith("/") ? undefined : "_blank"}
                          rel={event.data.url.startsWith("/") ? undefined : "noreferrer"}
                        >
                          Details
                        </a>
                      </p>
                    )
                  }
                </div>
              ))
            }
          </div>
        ) : (
          <p class="card empty-state">
            No upcoming events right now — join the community to hear about the next one.
            <br />
            <a href="/community/">Join the community</a> ·{" "}
            <a href="/blog/add-an-event/">Add an event</a>
          </p>
        )
      }
    </section>

    <section class="section-shell home-section">
      <h2 class="section-title">Community</h2>
      <ul class="home-links">
        {
          communityLinks.map((item) => (
            <li>
              <a href={item.link} target="_blank" rel="noreferrer">{item.name}</a>
            </li>
          ))
        }
      </ul>
      <div class="home-mailing">
        <MailingList />
      </div>
    </section>

    <section class="section-shell home-section">
      <p class="home-contributors">
        Rust India is run by its contributors.{" "}
        <a href="/contributors/">Meet them on the contributors page</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2.5rem;
    padding-top: 3.25rem;
  }

  .hero__copy {
    text-align: left;
  }

  .hero__title {
    font-size: clamp(3.8rem, 8vw, 6.2rem);
    line-height: 0.98;
  }

  .hero__lede {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--color-ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .hero__art {
    max-width: 26rem;
    width: 100%;
    height: auto;
  }

  @media (max-width: 959px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__copy {
      text-align: center;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__art {
      max-width: 20rem;
      margin-inline: auto;
    }
  }

  .home-section {
    margin-top: 4.5rem;
  }

  .home-section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 1.25rem;
  }

  .home-section__head .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
  }

  .home-section__link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  .home-section__link:hover {
    text-decoration: underline;
  }

  .home-section__lede {
    margin: 0.5rem 0 0;
    color: var(--color-ink-soft);
  }

  .feed-block__action {
    margin: 1.25rem 0 0;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .home-links a {
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
  }

  .home-links a:hover {
    color: var(--color-accent);
  }

  .home-mailing {
    margin-top: 2.5rem;
  }

  .home-contributors {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .home-contributors a {
    color: var(--color-accent);
  }
</style>
