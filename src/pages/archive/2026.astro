---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import heroArt from "../../assets/art/hero-past.png";

const heroArtSrc = typeof heroArt === "string" ? heroArt : heroArt.src;
import { confDay, workshopDay, sponsorTiers } from "../../data/2026-conference";

const tierLabels = {
  ferris: "Ferris",
  gold: "Gold",
  silver: "Silver",
  livestream: "Livestream",
};
---

<BaseLayout
  title="Rust India Conference 2026 | Past Events"
  description="Archive of the Rust India Conference 2026 in Bengaluru — schedule, speakers, and sponsors."
>
  <SiteHeader currentPath="/archive/2026/" />

  <main class="site-main">
    <section class="section-shell">
      <header class="page-header page-header--split">
        <div>
          <p class="section-label">Past event</p>
          <h1 class="page-title">Rust India Conference 2026</h1>
          <p class="page-lede">Bengaluru · NIMHANS Convention Center · April 18, 2026</p>
        </div>
        <img class="page-header__art" src={heroArtSrc} alt="" aria-hidden="true" />
      </header>

      <h2 class="section-title archive-heading">Schedule</h2>
      <div class="archive-block">
        <h3 class="archive-block__heading">Friday, April 17 — Workshops at e6data</h3>
        <div class="schedule-list">
          {
            workshopDay.map((entry) => (
              <div class="schedule-entry">
                <p class="schedule-entry__time">{entry.time}</p>
                <div class="schedule-entry__body">
                  <h4 class="schedule-entry__title">{entry.title}</h4>
                  <p class="schedule-entry__speaker">{entry.speaker} · {entry.role}</p>
                  <p class="schedule-entry__location">
                    <a href={entry.locationLink} target="_blank" rel="noreferrer">{entry.location}</a>
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <h3 class="archive-block__heading">Saturday, April 18 — Main Conference at NIMHANS</h3>
        <div class="schedule-list">
          {
            confDay.map((entry) => (
              <div class="schedule-entry">
                <p class="schedule-entry__time">{entry.time}</p>
                <div class="schedule-entry__body">
                  <h4 class="schedule-entry__title">{entry.title}</h4>
                  <p class="schedule-entry__speaker">{entry.speaker} · {entry.role}</p>
                  <p class="schedule-entry__location">
                    <a href={entry.locationLink} target="_blank" rel="noreferrer">{entry.location}</a>
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <h2 class="section-title archive-heading">Sponsors</h2>
      <div class="archive-block">
        {
          Object.entries(sponsorTiers).map(([tier, sponsors]) => (
            <div class="sponsor-tier">
              <h3 class="archive-block__heading">{tierLabels[tier]}</h3>
              <div class="sponsor-grid">
                {
                  sponsors.map((sponsor) => (
                    <a
                      href={sponsor.link}
                      class={`card sponsor-card sponsor-card--${tier}`}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={sponsor.name}
                    >
                      {sponsor.logo ? (
                        <img
                          class="sponsor-card__logo"
                          src={sponsor.logo}
                          alt={`${sponsor.name} logo`}
                        />
                      ) : (
                        <span class="sponsor-card__name">{sponsor.name}</span>
                      )}
                    </a>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>

      <h2 class="section-title archive-heading">What's next</h2>
      <div class="archive-block">
        <div class="card jobs-card">
          <h3 class="jobs-card__title">Looking for the next meetup?</h3>
          <p class="jobs-card__summary">The conference is over, but the community is not — new meetups and workshops are listed on the events page all year round.</p>
          <p>
            <a class="btn btn-primary" href="/events/">Visit the Events Page</a>
          </p>
        </div>
      </div>

      <p class="archive-note">
        This page archives the 2026 conference. See the <a href="/archive/schedule/">full schedule</a> and what is happening now on the <a href="/events/">events page</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .archive-heading {
    margin: 3.25rem 0 1.25rem;
    font-size: 1.9rem;
  }

  .archive-block__heading {
    margin: 1.75rem 0 1rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .schedule-list {
    display: grid;
    gap: 0.75rem;
  }

  .schedule-entry {
    display: grid;
    grid-template-columns: minmax(8rem, 10rem) minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .schedule-entry__time {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .schedule-entry__title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .schedule-entry__speaker {
    margin: 0.3rem 0 0;
    color: var(--color-ink-soft);
  }

  .schedule-entry__location {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .schedule-entry__location a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .sponsor-tier + .sponsor-tier {
    margin-top: 1.5rem;
  }

  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
  }

  .sponsor-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4.5rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    background: #ffffff;
  }

  .sponsor-card__logo {
    display: block;
    width: 100%;
    max-width: 100%;
    max-height: 3.25rem;
    height: auto;
    object-fit: contain;
  }

  .sponsor-card--platinum {
    min-height: 7rem;
  }

  .sponsor-card--platinum .sponsor-card__logo {
    max-height: 5rem;
  }

  .sponsor-card--gold {
    min-height: 6rem;
  }

  .sponsor-card--gold .sponsor-card__logo {
    max-height: 4.5rem;
  }

  .sponsor-card--silver {
    min-height: 5rem;
  }

  .sponsor-card--silver .sponsor-card__logo {
    max-width: 60%;
    max-height: 2.25rem;
  }

  .sponsor-card--livestream {
    min-height: 5.5rem;
    justify-self: center;
    width: 100%;
    max-width: 22rem;
  }

  .sponsor-card--livestream .sponsor-card__logo {
    max-height: 3rem;
  }

  .sponsor-card:hover {
    border-color: var(--color-accent);
  }

  .sponsor-card:hover .sponsor-card__name {
    color: var(--color-accent);
  }

  .sponsor-card__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    text-align: center;
  }

  .jobs-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .jobs-card__summary {
    margin: 0.75rem 0;
    color: var(--color-ink-soft);
    max-width: 42rem;
  }

  .archive-note {
    margin: 3.25rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-soft);
  }

  .archive-note a {
    color: var(--color-accent);
  }
</style>
