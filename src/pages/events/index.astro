---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PastEventCard from "../../components/PastEventCard.astro";
import { getCollection } from "astro:content";
import { eventSponsors } from "../../data/2026-conference";
import heroArt from "../../assets/art/hero-events.png";

const heroArtSrc = typeof heroArt === "string" ? heroArt : heroArt.src;

const allEvents = await getCollection("events");
const now = new Date();

const upcoming = allEvents
  .filter((event) => event.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = allEvents
  .filter((event) => event.data.date < now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat("en-IN", { dateStyle: "medium" });

function excerpt(body: string): string {
  return body
    .trim()
    .split(/\n\n+/)[0]
    .replace(/\n/g, " ")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .trim();
}
---

<BaseLayout
  title="Events | Rust India"
  description="Meetups, workshops, and gatherings for Rust folks in India."
>
  <SiteHeader currentPath="/events/" />

  <main class="site-main">
    <section class="section-shell">
      <header class="page-header page-header--split">
        <div>
          <p class="section-label">Events</p>
          <h1 class="page-title">Events</h1>
          <p class="page-lede">Meetups, workshops, and gatherings for Rust folks in India.</p>
        </div>
        <img class="page-header__art" src={heroArtSrc} alt="" aria-hidden="true" />
      </header>

      <h2 class="section-title events-heading">Upcoming</h2>
      {
        upcoming.length > 0 ? (
          <div class="card-grid">
            {
              upcoming.map((event) => (
                <div class="card event-card">
                  <p class="event-card__meta">
                    {dateFormat.format(event.data.date)} · {event.data.location}
                  </p>
                  <h3 class="event-card__title">{event.data.title}</h3>
                  <p class="event-card__desc">{excerpt(event.body)}</p>
                  {
                    event.data.url && (
                      <p class="event-card__action">
                        <a
                          class="btn btn-secondary"
                          href={event.data.url}
                          target={event.data.url.startsWith("/") ? undefined : "_blank"}
                          rel={event.data.url.startsWith("/") ? undefined : "noreferrer"}
                        >
                          Details
                        </a>
                      </p>
                    )
                  }
                </div>
              ))
            }
          </div>
        ) : (
          <p class="card empty-state">
            No upcoming events right now — join the community to hear about the next one.
            <br />
            <a href="/community/">Join the community</a> ·{" "}
            <a href="/blog/add-an-event/">Add an event</a>
          </p>
        )
      }

      <h2 class="section-title events-heading">Past</h2>
      {
        past.length > 0 ? (
          <div class="card-grid">
            {
              past.map((event) => (
                <PastEventCard event={event} sponsors={eventSponsors[event.data.url]} />
              ))
            }
          </div>
        ) : (
          <p class="card empty-state">No past events recorded yet.</p>
        )
      }

      <p class="events-note">
        Organizing a meetup or workshop?{" "}
        <a href="/blog/add-an-event/">Add an event to the site</a> with a pull request.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .events-heading {
    margin: 2.5rem 0 1.25rem;
    font-size: 1.6rem;
  }

  .events-note {
    margin: 3rem 0 0;
    color: var(--color-ink-soft);
  }

  .events-note a {
    color: var(--color-accent);
  }
</style>
