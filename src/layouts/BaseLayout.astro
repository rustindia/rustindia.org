---
import Analytics from "@vercel/analytics/astro";
import ferrisBadge from "../assets/ferris/ferris-badge.svg";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rust India",
  description = "The home of the Rust programming language community in India — blog, events, and ways to connect.",
} = Astro.props;

const ferrisBadgeSrc = typeof ferrisBadge === "string" ? ferrisBadge : ferrisBadge.src;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={ferrisBadgeSrc} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Rust India Blog" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <footer class="site-footer">
      <div class="section-shell site-footer__inner">
        <div class="site-footer__brand">
          <img src={ferrisBadgeSrc} alt="Ferris" class="brand-mark" />
          <span>Rust India</span>
        </div>

        <nav class="site-footer__links" aria-label="Footer">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
          <a href="/schedule/">Schedule</a>
          <a href="/sponsors/">Sponsors</a>
          <a href="/jobs/">Jobs</a>
          <a href="/community/">Community</a>
          <a href="/conduct/">Code of Conduct</a>
          <a href="/contributors/">Contributors</a>
          <a href="mailto:team@rustindia.org">Contact</a>
        </nav>

        <p class="site-footer__note">Built with Rust love for the Indian Rust community. git@blame -> swarnimarun.com</p>

        <p class="site-footer__note site-footer__note--disclaimer">Rust India is not sponsored or endorsed by the Rust Foundation.</p>
      </div>
    </footer>

    <script is:inline>
      const headerMenu = document.querySelector("[data-mobile-menu]");

      if (headerMenu) {
        headerMenu.addEventListener("toggle", () => {
          document.body.classList.toggle("menu-open", headerMenu.open);
        });
      }
    </script>

    <Analytics />
  </body>
</html>
